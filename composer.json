{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/jmwd-keystone-cms",
    "type": "project",
    "description": "A Laravel application.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "version": "0.2.3",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "artisanpack-ui/accessibility": "^2.1.0",
        "artisanpack-ui/analytics": "^1.1",
        "artisanpack-ui/cms-framework": "^2.5.3",
        "artisanpack-ui/core": "^1.0",
        "artisanpack-ui/forms": "^1.1",
        "artisanpack-ui/media-library": "^1.2.1",
        "artisanpack-ui/performance": "^1.0",
        "artisanpack-ui/privacy": "^1.0",
        "artisanpack-ui/rbac": "^1.0",
        "artisanpack-ui/security": "^2.0",
        "artisanpack-ui/security-auth": "^1.0",
        "artisanpack-ui/security-full": "^1.0",
        "artisanpack-ui/seo": "^1.1",
        "artisanpack-ui/visual-editor": "^1.1.0",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.16"
    },
    "require-dev": {
        "artisanpack-ui/code-style": "^1.1",
        "artisanpack-ui/code-style-pint": "^1.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --ansi",
            "@php artisan artisanpack:optional-packages-command",
            "@php artisan migrate --ansi",
            "@php artisan wayfinder:generate --no-interaction"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build:ssr",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#a78bfa\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,vite,ssr --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": "./vendor/bin/pint --test",
        "fix": "./vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
