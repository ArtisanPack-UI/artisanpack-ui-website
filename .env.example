APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR — disabled by default in dev; enable in production where the
# `php artisan inertia:start-ssr` Node process is running.
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# Keystone — site identity
KEYSTONE_SITE_TYPE=sbdf_pro

# Keystone — `/install` web wizard
# KEYSTONE_INSTALL_TOKEN guards the `/install` Inertia wizard
# pre-install: visit `https://<domain>/install?token=<value>`. The
# wizard rotates this value on successful provision so the URL you
# shared can never be reused. KEYSTONE_INSTALL_IP_ALLOWLIST is an
# optional comma-separated list (leave blank to allow any IP).
# KEYSTONE_INSTALL_FLAG_PATH overrides the `.installed` flag location.
KEYSTONE_INSTALL_TOKEN=
KEYSTONE_INSTALL_IP_ALLOWLIST=
# KEYSTONE_INSTALL_FLAG_PATH=

# Keystone — capabilities
KEYSTONE_BLOG_ENABLED=true
KEYSTONE_FORMS_ENABLED=true
KEYSTONE_ANALYTICS_ENABLED=true
KEYSTONE_ECOMMERCE_ENABLED=false
KEYSTONE_BOOKING_ENABLED=false

# Keystone — editor freedom
KEYSTONE_CUSTOM_CSS=false
KEYSTONE_FREESTYLE_LAYOUT=false
KEYSTONE_SHOW_RESPONSIVE_CONTROLS=false

# Keystone — limits (leave blank for unlimited)
KEYSTONE_MAX_PAGES=15
KEYSTONE_MAX_PRODUCTS=20
KEYSTONE_MAX_FORMS=10

# Keystone — admin bypass role
KEYSTONE_ADMIN_ROLE=admin

# Keystone — updates
# UPDATE_SOURCE_URL points the cms-framework Updates module at this
# install's release feed. Defaults to the public canonical repo;
# override per-client install if pointing at a fork.
UPDATE_SOURCE_URL=https://gitlab.com/jacob-martella-web-design/jacob-martella-web-design/jmwd-keystone-cms/jmwd-keystone-cms
# GITLAB_ACCESS_TOKEN is required when UPDATE_SOURCE_URL points at a
# private GitLab project (every client site). Use a project access token
# with `read_api` + `read_repository` scope. Leave blank to fall back to
# anonymous access (public repos only).
GITLAB_ACCESS_TOKEN=
# BACKUP_RETENTION_DAYS controls how long pre-update snapshot ZIPs in
# `storage/backups/application/` are kept before the next successful
# update prunes them. Default mirrors the framework's own default.
BACKUP_RETENTION_DAYS=30

# Keystone — edge cache
KEYSTONE_EDGE_CACHE_ENABLED=true
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Keystone — privacy (artisanpack-ui/privacy). All four supported
# regulations (GDPR, CCPA, LGPD, PIPEDA) default to enabled so the
# banner and DSR flows honour the widest applicable set out of the
# box. Override per-install to opt a jurisdiction off.
PRIVACY_ENABLED=true
PRIVACY_GDPR_ENABLED=true
PRIVACY_CCPA_ENABLED=true
PRIVACY_LGPD_ENABLED=true
PRIVACY_PIPEDA_ENABLED=true
# PRIVACY_ADMIN_EMAIL receives new-DSR notifications from the package
# and is the fallback recipient for the monthly compliance report when
# no DPO email is set. Leave blank in local/dev to skip both.
PRIVACY_ADMIN_EMAIL=
# PRIVACY_BREACH_* powers the publishable authority + user
# notification templates. `AUTHORITY_EMAIL` is copied on breach
# notifications; the `DPO_*` block appears in the notification body
# and (for `_EMAIL`) is the preferred recipient of the monthly
# compliance report.
PRIVACY_BREACH_AUTHORITY_EMAIL=
PRIVACY_BREACH_DPO_NAME=
PRIVACY_BREACH_DPO_EMAIL=
PRIVACY_BREACH_DPO_PHONE=

# Keystone — performance (artisanpack-ui/performance). The perf
# package ships every feature disabled; Keystone flips the four
# capabilities that give the most value with the least admin burden
# to on out of the box:
#
#   - image_optimization → media-library uploads auto-generate WebP,
#     AVIF, and responsive size variants (`optimize_on_upload` and
#     `generate_formats_on_upload` in config default to true).
#   - page_cache → the perf package's page cache layer (complements
#     Keystone's origin response cache — see #91 — and the Cloudflare
#     cache-tag purge — see #20 — rather than replacing either).
#   - fragment_cache → per-fragment cache with tag invalidation the
#     PerformanceServiceProvider bridges to the Cloudflare purge job
#     so origin + edge stay in lockstep.
#   - monitoring → RUM Web Vitals collector rendered by `@perfMonitor`
#     in `resources/views/app.blade.php`, gated by
#     `privacyHasConsent('analytics')` so no beacon fires without
#     analytics consent under any enabled regulation.
#
# The remaining features (speculative loading, Early Hints, slow-
# query logging, HTML minification) ship off until an admin opts in
# from Settings → Performance.
#
# UPGRADE NOTE: these four lines are new in this release. An upgrader
# whose `.env` was cloned from an earlier `.env.example` won't pick
# them up automatically — copy them into your `.env` (or set them via
# Settings → Performance in the admin UI, which writes to `.env`) to
# match the epic's default posture. The plumbing (routes, admin nav,
# background commands) always installs regardless of these flags.
PERF_IMAGE_OPTIMIZATION=true
PERF_PAGE_CACHE=true
PERF_FRAGMENT_CACHE=true
PERF_MONITORING=true
