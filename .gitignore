# Dependencies
/node_modules
/vendor

# Environment
.env
.env.backup
.env.production
.env.*.local
.env.local

# Build artifacts
/public/build
/public/hot
/public/storage
/public/vendor
/public/visual-editor
/bootstrap/ssr

# Wayfinder-generated TS — regenerated by `npm run wayfinder:generate`
# (runs automatically via predev/prebuild/postinstall hooks).
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# User uploads (media-library writes to storage/app/public via the `public` disk)
/storage/app/public

# Theme upload staging — ThemeInstaller extracts zips here before moving
# the validated theme into `themes/`. Cleaned per-install in a `finally`,
# but ignored just in case a crash leaves a partial extraction behind.
/storage/app/theme-uploads

# Plugin directory contents — PluginManager::installFromZip extracts here,
# and dev plugins may be worked on in place as their own independent git
# repos. Keystone's repo tracks the directory (via .gitkeep) but not its
# contents, so each subdirectory is free to be its own repo.
/plugins/*
!/plugins/.gitkeep
!/plugins/artisanpack-ui

# Installer flag — written by `keystone:install` to lock /install and signal
# the `installed` middleware. Per-environment runtime state, never committed.
/storage/app/.installed
/storage/app/temp

# Laravel storage & cache
/storage/*.key
/storage/pail
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/test-plugins-*
/storage/logs/*
!/storage/logs/.gitkeep
/storage/backups

# Test & tooling caches
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
.php-cs-fixer.cache
.pint.cache
/.phpstan.cache
/coverage
/.nyc_output

# Pest browser plugin (#35) — Playwright spawns chromium per test and writes
# trace bundles / screenshot diffs under these paths when assertions fail.
/test-results
/.cache/ms-playwright

# Local SQLite dev database — Herd creates this on first artisan migrate.
# Schema lives in migrations; the binary is per-developer and must never
# ship in the repo or the release tarball.
/database/database.sqlite

# Composer & npm
auth.json
composer.phar
npm-debug.log
npm-debug.log*
yarn-error.log
yarn-debug.log*
pnpm-debug.log*

# Homestead / Vagrant
Homestead.json
Homestead.yaml
.vagrant

# IDE & editors
/.idea
/.vscode
/.fleet
/.zed
/.nova
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local AI tool overrides (keep shared configs tracked)
.claude/settings.local.json
.claude/.credentials.json

# Misc
*.log
.claude/scheduled_tasks.lock

# Local-only docs (never commit credentials, even for dev)
/docs/local/
