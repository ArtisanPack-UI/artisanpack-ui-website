{
    "private": true,
    "type": "module",
    "scripts": {
        "wayfinder:generate": "php artisan wayfinder:generate --no-interaction && php artisan wayfinder:sanitize-paths && node scripts/sanitize-wayfinder-actions.mjs",
        "predev": "npm run wayfinder:generate",
        "prebuild": "npm run wayfinder:generate",
        "prebuild:ssr": "npm run wayfinder:generate",
        "pretype-check": "npm run wayfinder:generate",
        "pretypecheck": "npm run wayfinder:generate",
        "prelint": "npm run wayfinder:generate",
        "build": "vite build",
        "postbuild": "php artisan wayfinder:sanitize-paths",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\"",
        "type-check": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "postinstall": "node scripts/build-visual-editor.mjs && node scripts/sync-visual-editor.mjs && npm run wayfinder:generate && node scripts/ensure-playwright-browsers.mjs",
        "build:visual-editor": "node scripts/build-visual-editor.mjs",
        "sync:visual-editor": "node scripts/sync-visual-editor.mjs"
    },
