        "@artisanpack-ui/react": "^1.0.0",
        "@artisanpack-ui/react-laravel": "^1.0.0",
        "@artisanpack-ui/tokens": "^1.0.0",
        "@artisanpack-ui/visual-editor": "file:vendor/artisanpack-ui/visual-editor",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@inertiajs/react": "^2.0.0",
        "apexcharts": "^3.54.1",
        "nprogress": "^0.2.0",
        "react": "^19.0.0",
        "react-apexcharts": "^1.5.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.6.0",
        "web-vitals": "^3.5.2"
    },
    "overrides": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
