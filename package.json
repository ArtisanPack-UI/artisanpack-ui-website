        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@originjs/vite-plugin-federation": "^1.4.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.0.0",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "autoprefixer": "^10.4.20",
        "axios": "^1.7.4",
        "concurrently": "^10.0.0",
        "daisyui": "^5.0.46",
