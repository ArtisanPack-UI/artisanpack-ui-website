{
    "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
    "name": "ArtisanPack UI",
    "slug": "artisanpack-ui",
    "version": "1.0.0",
    "description": "Atmospheric, dark-first marketing theme for JMWD Keystone. Neon triad (blue / cyan / magenta) over deep space-black grounds with one gradient moment per view. Ships blog, packages, and a rich pattern library.",
    "author": "Jacob Martella",
    "screenshot": "screenshot.png",
    "requires": "2.0.0",

    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": true,
            "customGradient": true,
            "palette": [
                { "slug": "primary",        "name": "Primary",        "color": "#2962FF" },
                { "slug": "secondary",      "name": "Secondary",      "color": "#00E5FF" },
                { "slug": "accent",         "name": "Accent",         "color": "#E040FB" },
                { "slug": "base",           "name": "Base",           "color": "#111827" },
                { "slug": "section",        "name": "Section",        "color": "#1F2937" },
                { "slug": "surface",        "name": "Surface",        "color": "#1F2937" },
                { "slug": "surface-2",      "name": "Surface 2",      "color": "#111827" },
                { "slug": "ink",            "name": "Ink",            "color": "#0B1120" },
                { "slug": "text",           "name": "Text",           "color": "#FFFFFF" },
                { "slug": "text-muted",     "name": "Text Muted",     "color": "#9CA3AF" },
                { "slug": "text-subtle",    "name": "Text Subtle",    "color": "#6B7280" },
                { "slug": "text-link",      "name": "Text Link",      "color": "#00E5FF" },
                { "slug": "border",         "name": "Border",         "color": "#374151" },
                { "slug": "border-subtle",  "name": "Border Subtle",  "color": "#263143" },
                { "slug": "border-strong",  "name": "Border Strong",  "color": "#4B5563" },
                { "slug": "neutral-0",      "name": "Neutral 0",      "color": "#F9FAFB" },
                { "slug": "neutral-1",      "name": "Neutral 1",      "color": "#F3F4F6" },
                { "slug": "neutral-2",      "name": "Neutral 2",      "color": "#E5E7EB" },
                { "slug": "neutral-3",      "name": "Neutral 3",      "color": "#D1D5DB" },
                { "slug": "neutral-4",      "name": "Neutral 4",      "color": "#9CA3AF" },
                { "slug": "neutral-5",      "name": "Neutral 5",      "color": "#6B7280" },
                { "slug": "neutral-6",      "name": "Neutral 6",      "color": "#4B5563" },
                { "slug": "neutral-7",      "name": "Neutral 7",      "color": "#374151" },
                { "slug": "neutral-8",      "name": "Neutral 8",      "color": "#1F2937" },
                { "slug": "neutral-9",      "name": "Neutral 9",      "color": "#111827" },
                { "slug": "success",        "name": "Success",        "color": "#22C55E" },
                { "slug": "danger",         "name": "Danger",         "color": "#EF4444" },
                { "slug": "warning",        "name": "Warning",        "color": "#F59E0B" },
                { "slug": "info",           "name": "Info",           "color": "#2962FF" }
            ],
            "gradients": [
                { "slug": "primary-secondary",   "name": "Primary → Secondary",   "gradient": "linear-gradient(115deg, #2962FF 0%, #00E5FF 100%)" },
                { "slug": "primary-accent",      "name": "Primary → Accent",      "gradient": "linear-gradient(115deg, #2962FF 0%, #E040FB 100%)" },
                { "slug": "secondary-primary",   "name": "Secondary → Primary",   "gradient": "linear-gradient(115deg, #00E5FF 0%, #2962FF 100%)" },
                { "slug": "secondary-accent",    "name": "Secondary → Accent",    "gradient": "linear-gradient(115deg, #00E5FF 0%, #E040FB 100%)" },
                { "slug": "accent-primary",      "name": "Accent → Primary",      "gradient": "linear-gradient(115deg, #E040FB 0%, #2962FF 100%)" },
                { "slug": "accent-secondary",    "name": "Accent → Secondary",    "gradient": "linear-gradient(115deg, #E040FB 0%, #00E5FF 100%)" },
                { "slug": "neon",                "name": "Neon (three-stop)",          "gradient": "linear-gradient(115deg, #2962FF 0%, #00E5FF 50%, #E040FB 100%)" }
            ]
        },
        "typography": {
            "customFontSize": true,
            "lineHeight": true,
            "letterSpacing": true,
            "textTransform": true,
            "fontStyle": true,
            "fontWeight": true,
            "fontFamilies": [
                { "slug": "sans",    "name": "Sans (Poppins)",    "fontFamily": "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
                { "slug": "display", "name": "Display (Poppins)", "fontFamily": "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
                { "slug": "mono",    "name": "Mono (Space Mono)", "fontFamily": "'Space Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace" }
            ],
            "fontSizes": [
                { "slug": "xsmall",     "name": "X-Small",     "size": "0.8125rem" },
                { "slug": "small",      "name": "Small",       "size": "0.875rem" },
                { "slug": "body",       "name": "Body",        "size": "1rem" },
                { "slug": "h6",         "name": "H6",          "size": "1.125rem" },
                { "slug": "h5",         "name": "H5",          "size": "1.375rem" },
                { "slug": "h4",         "name": "H4",          "size": "1.75rem" },
                { "slug": "h3",         "name": "H3",          "size": "2.25rem" },
                { "slug": "h2",         "name": "H2",          "size": "2.75rem" },
                { "slug": "h1",         "name": "H1",          "size": "3.5rem" },
                { "slug": "blockquote", "name": "Blockquote",  "size": "1.75rem" }
            ]
        },
        "spacing": {
            "spacingSizes": [
                { "slug": "0",   "name": "None",       "size": "0"       },
                { "slug": "20",  "name": "2X-Small",   "size": "0.25rem" },
                { "slug": "30",  "name": "X-Small",    "size": "0.5rem"  },
                { "slug": "40",  "name": "Small",      "size": "1rem"    },
                { "slug": "50",  "name": "Medium",     "size": "1.5rem"  },
                { "slug": "60",  "name": "Large",      "size": "2rem"    },
                { "slug": "70",  "name": "X-Large",    "size": "3rem"    },
                { "slug": "80",  "name": "2X-Large",   "size": "4rem"    },
                { "slug": "90",  "name": "3X-Large",   "size": "6rem"    },
                { "slug": "100", "name": "4X-Large",   "size": "7.5rem"  }
            ],
            "customSpacingSize": true,
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"]
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": {
            "defaultPresets": true
        },
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        }
    },

    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text":       "var(--wp--preset--color--text)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "fontSize":   "var(--wp--preset--font-size--body)",
            "lineHeight": "1.65"
        },
        "spacing": {
            "blockGap": "1.5rem"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize":   "var(--wp--preset--font-size--h1)",
                    "fontWeight": "600",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.02em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize":   "var(--wp--preset--font-size--h2)",
                    "fontWeight": "600",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.02em"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize":   "var(--wp--preset--font-size--h3)",
                    "fontWeight": "600",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.02em"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize":   "var(--wp--preset--font-size--h4)",
                    "fontWeight": "600",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.02em"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize":   "var(--wp--preset--font-size--h5)",
                    "fontWeight": "600",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.02em"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize":   "var(--wp--preset--font-size--h6)",
                    "fontWeight": "600",
                    "lineHeight": "1.35",
                    "letterSpacing": "-0.01em"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text":       "var(--wp--preset--color--text)"
                },
                "border": {
                    "color":  "var(--wp--preset--color--primary)",
                    "style":  "solid",
                    "width":  "2px",
                    "radius": "5px"
                },
                "typography": {
                    "fontFamily":    "var(--wp--preset--font-family--sans)",
                    "fontWeight":    "600",
                    "letterSpacing": "0.02em"
                },
                "spacing": {
                    "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" }
                }
            },
            "link": {
                "color": { "text": "var(--wp--preset--color--text-link)" },
                ":hover": { "color": { "text": "var(--wp--preset--color--secondary)" } }
            }
        },
        "blocks": {
            "artisanpack/quote": {
                "border": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "0 0 0 4px" },
                "spacing": { "padding": { "left": "1.5rem", "top": "0.5rem", "bottom": "0.5rem" } },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontStyle":  "italic",
                    "fontSize":   "var(--wp--preset--font-size--blockquote)",
                    "lineHeight": "1.35"
                }
            },
            "artisanpack/card": {
                "color": { "background": "var(--wp--preset--color--surface-2)" },
                "border": {
                    "color":  "var(--wp--preset--color--surface-2)",
                    "style":  "solid",
                    "width":  "3px",
                    "radius": "12px"
                },
                "spacing": { "padding": { "top": "1.5rem", "bottom": "1.5rem", "left": "1.5rem", "right": "1.5rem" } }
            }
        }
    },

    "customTemplates": [
        { "name": "page-header-centered",  "title": "Page — Centered Header",    "postTypes": ["page"] },
        { "name": "page-header-display",   "title": "Page — Display Header",     "postTypes": ["page"] },
        { "name": "page-header-editorial", "title": "Page — Editorial Header",   "postTypes": ["page"] },
        { "name": "page-header-compact",   "title": "Page — Compact Header",     "postTypes": ["page"] },
        { "name": "page-header-boxed",     "title": "Page — Boxed Header",       "postTypes": ["page"] },
        { "name": "page-no-header",        "title": "Page — No Header",          "postTypes": ["page", "package"] },
        { "name": "page-blank",            "title": "Page — Blank",              "postTypes": ["page", "package"] },
        { "name": "single-post-longform",  "title": "Post — Longform",           "postTypes": ["post"] }
    ],

    "templateParts": [
        { "name": "header",      "title": "Header",      "area": "header" },
        { "name": "footer",      "title": "Footer",      "area": "footer" },
        { "name": "mobile-menu", "title": "Mobile Menu", "area": "navigation-overlay" }
    ],

    "patterns": [
        "page-header-centered",
        "page-header-display",
        "page-header-editorial",
        "page-header-compact",
        "page-header-boxed",

        "hero-centered",
        "hero-split",
        "hero-package",
        "hero-image",
        "hero-stats",
        "hero-terminal",

        "features",
        "features-grid",
        "features-side-title",
        "features-alt-rows",
        "features-lead-media",
        "features-bento",
        "features-cards",

        "testimonials",
        "testimonials-grid",
        "testimonials-wall",
        "testimonials-side-title",
        "testimonials-spotlight",
        "testimonials-side-image",
        "testimonials-overlap",
        "testimonials-carousel",

        "pricing",
        "pricing-two",
        "pricing-four",
        "pricing-toggle",
        "pricing-spotlight",
        "pricing-comparison",

        "packages-portfolio",
        "packages-install",
        "packages-meta",
        "packages-featured",
        "packages-list",
        "packages-compact",
        "packages-bento",
        "packages-large",
        "packages-stats",

        "blog-posts",
        "blog-grid",
        "blog-featured",
        "blog-rows",
        "blog-overlay",
        "blog-list",
        "blog-side-heading",
        "blog-magazine",

        "faq",
        "faq-two-column",
        "faq-side-heading",
        "faq-categorized",
        "faq-open",
        "faq-boxed",
        "faq-search",
        "faq-support",
        "faq-numbered",

        "cta",
        "cta-simple",
        "cta-inline",
        "cta-wide-image",
        "cta-gradient-box",
        "cta-signup-centered",
        "cta-signup-split",
        "cta-signup-gradient",
        "cta-signup-image",

        "text-media-split",
        "text-media-banner",
        "text-media-grid",
        "text-media-gallery",
        "text-media-bento-text",
        "text-media-collage",
        "text-media-bento",
        "text-media-stacked",
        "text-media-spotlight",

        "home-full",
        "about-full",
        "contact-full",
        "newsletter-full",
        "getting-started-full",
        "package-landing-generic"
    ],

    "menus": {
        "locations": {
            "primary":           "Primary Menu",
            "footer-packages":   "Footer — Packages",
            "footer-resources":  "Footer — Resources",
            "footer-legal":      "Footer — Legal",
            "social":            "Social Links"
        }
    },

    "supports": {
        "comments":       true,
        "featured-image": true
    }
}
